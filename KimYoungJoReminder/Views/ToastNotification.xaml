<Window x:Class="KimYoungJoReminder.Views.ToastNotification"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Width="350"
        Height="100"
        WindowStartupLocation="Manual">
    <Border Background="#2D2D30" BorderBrush="#007ACC" BorderThickness="2" CornerRadius="5">
        <Border.Effect>
            <DropShadowEffect Color="Black" Direction="270" ShadowDepth="3" Opacity="0.5" BlurRadius="10"/>
        </Border.Effect>

        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 제목 -->
            <TextBlock x:Name="txtTitle"
                       Grid.Row="0"
                       Text="Reminder"
                       Foreground="#4EC9B0"
                       FontSize="14"
                       FontWeight="Bold"
                       Margin="0,0,0,5"/>

            <!-- 메시지 -->
            <TextBlock x:Name="txtMessage"
                       Grid.Row="1"
                       Text="Message"
                       Foreground="White"
                       FontSize="12"
                       TextWrapping="Wrap"/>
        </Grid>
    </Border>
</Window>
